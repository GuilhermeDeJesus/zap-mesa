# /home/zapmesa/public_html/.htaccess
#
# NOTA: ProxyPass/ProxyPassReverse NÃO são permitidos em .htaccess no cPanel.
# O proxy reverso fica em:
#   /etc/apache2/conf.d/userdata/std/2_4/zapmesa/zapmesa.com.br/proxy.conf  (HTTP)
#   /etc/apache2/conf.d/userdata/ssl/2_4/zapmesa/zapmesa.com.br/proxy.conf  (HTTPS)
# Após editar os arquivos acima, rodar:
#   /usr/local/cpanel/scripts/rebuildhttpdconf && systemctl reload httpd

Options -MultiViews
RewriteEngine On

# ACME challenge (Let's Encrypt / AutoSSL) - servir direto do filesystem
RewriteRule ^\.well-known/ - [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
