POSTGRES_USER=zapmesa
POSTGRES_PASSWORD=troque-essa-senha
POSTGRES_DB=zapmesa
JWT_SECRET=troque-por-um-segredo-forte
APP_URL=https://seu-dominio.com
PUBLIC_API_URL=https://seu-dominio.com/api
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# ── Deploy cPanel (MySQL/MariaDB + sem Docker postgres) ───────────────
# DATABASE_URL para MySQL do cPanel (use host.docker.internal para acessar do container)
DATABASE_URL=mysql://DB_USER:DB_PASS@host.docker.internal:3306/DB_NAME

# ── SMTP (conta de email do cPanel) ───────────────────────────────────
SMTP_HOST=mail.zapmesa.com.br
SMTP_PORT=587
SMTP_USER=noreply@zapmesa.com.br
SMTP_PASS=senha-do-email
SMTP_FROM="ZapMesa <noreply@zapmesa.com.br>"
